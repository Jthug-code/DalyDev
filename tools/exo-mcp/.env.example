# exo master REST API (Tailscale IP, localhost, or Tailscale Serve URL)
EXO_BASE_URL=http://127.0.0.1:52415

# Optional bearer token if you front the API with auth
EXO_API_TOKEN=

# Seconds to wait for long inference (default 600)
EXO_REQUEST_TIMEOUT=600
EXO_CONNECT_TIMEOUT=10

# Cap for exo_cluster_events (default 50, max 500)
EXO_MAX_EVENTS=50
